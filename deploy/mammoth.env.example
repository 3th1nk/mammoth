# mammoth serve — dotenv example (bare-binary deployment).
# Copy to a stable path, edit the values, then:
#   bin/mammoth serve --env-file /etc/mammoth.env
#   (or set MAMMOTH_ENV_FILE=/etc/mammoth.env)
# Existing environment variables win over file entries, and invalid values
# fail startup instead of silently defaulting.

# --- Core ---
# PostgreSQL (>= 14): stores state, credentials and the task queue.
MAMMOTH_DATABASE_URL=postgres://mammoth:mammoth@127.0.0.1:5432/mammoth?sslmode=disable

# HTTP listener, and the externally-reachable base URL that machines use to
# fetch answer files and POST completion callbacks (an installer's network
# must be able to reach this).
MAMMOTH_HTTP_ADDR=:80
MAMMOTH_EXTERNAL_URL=http://198.51.100.248

# Bearer token for the control-plane API (used by bin/mammoth and integrations).
MAMMOTH_API_TOKEN=change-me-api-token

# Master key for encrypting BMC/SSH credentials at rest. Generate once with
# `openssl rand -base64 32`. Rotating it invalidates stored credentials —
# re-create credentials and re-point machines at them.
MAMMOTH_MASTER_KEY=generate-with-openssl-rand-base64-32

# --- Storage ---
# Media repository (distro ISOs and unpacked trees) and scratch space.
MAMMOTH_MEDIA_DIR=/data/mammoth/media
MAMMOTH_MEDIA_WORKDIR=/data/mammoth/work
# Where the media repository is NFS-exported for in-place mounting.
MAMMOTH_MEDIA_BASE_URI=nfs://198.51.100.248/data/mammoth/media

# --- PXE (builtin proxyDHCP + TFTP) ---
MAMMOTH_PXE_ENABLED=true
# Address PXE clients use as next-server (must reach this host's HTTP too).
MAMMOTH_PXE_NEXT_SERVER=198.51.100.248
# Address pool handed to installing machines (one per concurrent install).
MAMMOTH_PXE_DHCP_POOL=198.51.100.211,198.51.100.212,198.51.100.215,198.51.100.216,198.51.100.217

# --- Debian installer (d-i) netboot assets ---
MAMMOTH_PXE_DI_NETBOOT=/data/mammoth/work/netboot-trixie.tar.gz
MAMMOTH_PXE_DI_UDEBS_DIR=/data/mammoth/work/di-udebs

# --- Ramdisk probe (alpine carrier) ---
MAMMOTH_PROBE_ALPINE_ISO=/data/mammoth/work/alpine-standard-3.22.5-x86_64.iso
MAMMOTH_PROBE_ALPINE_NETBOOT=/data/mammoth/work/alpine-netboot-3.22.0-x86_64.tar.gz

# --- BMC ---
# Accept self-signed certificates on BMC Redfish endpoints (factory iBMC /
# iDRAC firmware commonly ships without a certificate chain of trust).
MAMMOTH_BMC_TLS_INSECURE=true
# Enable the ramdisk-probe discover path (probe: ramdisk).
MAMMOTH_RAMDISK_ENABLED=true

# --- Windows over PXE (wimboot carrier) ---
# Deployment-provided read-only SMB export of MAMMOTH_MEDIA_DIR: the WinPE
# startnet maps this share and launches setup from it. Credentials are
# optional — omit USER/PASSWORD for guest access on a share that allows it.
# The UNC must use backslashes exactly as shown.
MAMMOTH_WINDOWS_INSTALL_SMB_UNC=\\198.51.100.248\mammoth-media
MAMMOTH_WINDOWS_INSTALL_SMB_USER=mammoth-smb
MAMMOTH_WINDOWS_INSTALL_SMB_PASSWORD=change-me-smb-password
