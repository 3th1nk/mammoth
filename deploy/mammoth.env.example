# mammoth serve — 全量环境变量模板(按部署形态分段)
#
# 用法(裸二进制):
#   bin/mammoth serve --env-file /etc/mammoth.env   (或 MAMMOTH_ENV_FILE=...)
# compose 部署:复制所需段到 .env 放 compose 文件同目录即可被读取。
# 现有环境变量优先于文件条目;非法值直接拒绝启动(不静默回退默认)。
# 注释行展示的 = 默认值(以 internal/config/config.go 为准);
# 默认为空 = 功能关闭,注释里以「空 = ...」说明开启后的语义。
# 逐变量完整释义(默认值/适用形态/消费者):docs/env-vars.md
#
# ── 部署形态 → 用哪些段 ────────────────────────────────────────────────
# 形态 A · 单网段(引擎在机器段,builtin 池模式)
#   compose.all-in-one.yml —— Core + Storage + PXE·段内 + [探针/认领] + [介质/发行版]
# 形态 B · 分面(faceted,api + runner)
#   compose.faceted.yml —— 同形态 A;PXE 段只配在 api,BMC/执行段只配在 runner
# 形态 C · 跨网段(引擎在承载网,external 模式;每装机 VLAN 一台 edge)
#   引擎侧 —— Core + Storage + PXE·跨网段 + [探针/认领] + [介质/发行版]
#   edge 侧 —— 见 edge.env.example(只认 MAMMOTH_EDGE_*)
# 两种 PXE 段互斥:同份 .env 里 PXE·段内 与 PXE·跨网段 只能取一。
#
# ── 三条校验红线(违反即拒绝启动,config.Config.Validate)──────────────
# 1. MAMMOTH_PXE_MODE=external 时 MAMMOTH_PXE_DHCP_POOL 必须清掉
#    (external 不持有 DHCP——地址归站点 DHCP);
# 2. MAMMOTH_PXE_UEFI_NBP=ipxe 在 external 模式无意义,拒启
#    (external 不发 DHCP 应答;NBP 链在 edge --uefi-nbp 或站点 DHCP 67 配);
# 3. MAMMOTH_PXE_ENROLL=true 时 MAMMOTH_PXE_ENROLL_TOKEN 必填。
# 另:MAMMOTH_PXE_ENABLED=true(builtin)要求 NEXT_SERVER 可解析出 IPv4
# (EXTERNAL_URL 是 IP 字面量时可自动派生);MAMMOTH_BOOT_STRATEGY=pxe
# 要求 MAMMOTH_PXE_ENABLED=true。

# ═══ 1. Core —— 所有形态必配 ══════════════════════════════════════════

# 进程形态(serve 子命令 --mode=all|api|runner 同名覆盖;compose 已按角色写死)
#MAMMOTH_MODE=all

# PostgreSQL(>= 14):状态、凭证、任务队列的唯一强依赖(必填,无默认)
MAMMOTH_DATABASE_URL=postgres://mammoth:mammoth@127.0.0.1:5432/mammoth?sslmode=disable

# HTTP 监听;EXTERNAL_URL = 机器/edge 可达的外部基地址(拉应答文件、介质、
# 完成回调都走它)——必须是机器网段可路由地址,永不为 loopback。
# 形态 B 跨机器展开时指向 api 前面的 LB VIP。
MAMMOTH_HTTP_ADDR=:8080
MAMMOTH_EXTERNAL_URL=http://198.51.100.248

# 控制面 Bearer token(bin/mammoth 与集成方用;必填)
MAMMOTH_API_TOKEN=change-me-api-token

# 静态加密主密钥(BMC/SSH 凭证落库;必填)。`openssl rand -base64 32` 生成
# 一次;轮换 = 已存凭证全部不可解。形态 B 跨机器:所有节点必须同值。
MAMMOTH_MASTER_KEY=generate-with-openssl-rand-base64-32

# 日志级别 / 格式(默认 json;人工 tail 排障可切 text)
#MAMMOTH_LOG_LEVEL=info
#MAMMOTH_LOG_FORMAT=json
# /metrics 独立监听地址(空 = 随 MAMMOTH_HTTP_ADDR 一并服务)
#MAMMOTH_METRICS_ADDR=
# OTLP 导出端点(空 = 不导出 trace)
#MAMMOTH_OTEL_EXPORTER_ENDPOINT=

# ═══ 2. Storage —— vMedia/介质组装用(纯 PXE 无带外可留默认) ════════════

# 介质仓库(distro ISO 与解包树)与 scratch(空 = 紧邻介质目录的 work/)
#MAMMOTH_MEDIA_DIR=data/media
#MAMMOTH_MEDIA_WORKDIR=
# 介质仓库的 NFS 导出地址(BMC vMedia 与 ubuntu casper nfsroot 的挂载源)。
# 单旋钮双消费者:BMC 与 casper 必须是同一 NFS 服务端(roadmap 2026-10-27 注)。
# 空 = 不声明 NFS 源(vMedia 不可用)。
# 形态 C:vMedia 要求 BMC 与引擎可路由(管理网直连/静态路由),不用 vMedia
# (纯 PXE)可留空,BMC 侧不挂载即可。
#MAMMOTH_MEDIA_BASE_URI=nfs://198.51.100.248/data/mammoth/media

# ═══ 3. PXE · 段内形态(builtin 池模式;引擎在机器 L2)═══════════════════
# 与第 4 段互斥。引擎 builtin = 完整 proxyDHCP + TFTP + 只对已装载引导条目的任务 MAC
# 发租约的 DHCP 池(陌生客户端不耗池)。

#MAMMOTH_PXE_ENABLED=false
# PXE 客户端拿到的 next-server(必须同时可达本机 HTTP;EXTERNAL_URL 为 IP
# 字面量时可省略,自动派生)
#MAMMOTH_PXE_NEXT_SERVER=198.51.100.248
# 引导期地址池(每台并发装机一个地址;allowlist 门禁——只应答引导条目已装载/已
# enroll 的 MAC;空 = 不发租约,纯 proxyDHCP)。与站点 DHCP 并存 = pool+
# enroll 一体 OFFER 形态(需 MAMMOTH_PXE_ENROLL 同开),租约有竞速,办公网
# 先核 snooping。
#MAMMOTH_PXE_DHCP_POOL=198.51.100.211,198.51.100.212,198.51.100.215
# 池租约下发的网关(空 = NEXT_SERVER)
#MAMMOTH_PXE_DHCP_ROUTER=198.51.100.1
# PXE 应答广播地址(空 = 受限广播 255.255.255.255;定向广播替换用于
# macOS/vmnet 桥接的 qemu 验证环境,Linux 部署无需)
#MAMMOTH_PXE_BROADCAST_ADDR=198.51.100.255
# WoL 直发(引擎在机器段):无带外机器 boot 阶段的定向广播(空 = 关)
#MAMMOTH_PXE_WOL_BROADCAST=198.51.100.255
# 端口(宿主已占用或非特权环境时改)
#MAMMOTH_PXE_DHCP_PORT=67
#MAMMOTH_PXE_TFTP_PORT=69
#MAMMOTH_PXE_BOOTSRV_PORT=4011
#MAMMOTH_PXE_SYSLOG_PORT=514
# UEFI NBP 链(仅 builtin;external 下配 ipxe 拒启):shim = 签名链
# (SB 有效)| ipxe = 裸 iPXE(绕开 grub2 不消费 UEFI Proxy DHCP 的上游
# 缺陷,proxy 拓扑 UEFI 机型用,SB 须关——判据见 operations §共存节)
#MAMMOTH_PXE_UEFI_NBP=shim

# ═══ 4. PXE · 跨网段形态(external;引擎在承载网 + 每装机 VLAN 一台 edge)══
# 与第 3 段互斥。引擎零 DHCP/TFTP 绑定,引导应答归 edge(见 edge.env.example),
# 地址归装机段站点 DHCP。edge 侧的 NEXT_SERVER/UEFI_NBP 都在 edge 配,引擎
# 侧不声明任何"装机段地址"。

#MAMMOTH_PXE_ENABLED=true
#MAMMOTH_PXE_MODE=external
# 红线:此模式下清掉 MAMMOTH_PXE_NEXT_SERVER 与 MAMMOTH_PXE_DHCP_POOL。
# 跨段 WoL(装机 boot 阶段由 edge 代发;与 edge 侧 MAMMOTH_EDGE_WOL_* 配对,
# token 两边同值;空 = 不代发,人工上电自愈):
#MAMMOTH_PXE_WOL_PROXY_URL=http://198.51.100.10:9100
#MAMMOTH_PXE_WOL_PROXY_TOKEN=change-me-same-as-edge-wol-token

# ═══ 5. 无带外认领(enroll→claim;叠加在形态 A/C 上,默认关)═════════════
# 开启后未知 MAC 的 PXE 客户端收到共享探针(alpine miniproot),扫 /sys +
# SMART + NIC 报告进 pending_machines 认领台账;探针报告端点以
# /netboot/enroll/<TOKEN> 为门禁(网段内任意主机可伪造 sighting,token 是
# 唯一防线)。TOKEN 只配引擎这一处,探针树构建时自动内嵌。
#MAMMOTH_PXE_ENROLL=false
#MAMMOTH_PXE_ENROLL_TOKEN=

# ═══ 6. 探针与无带外执行面(ramdisk 探针 / enroll 载体)══════════════════

# ramdisk 探针 discover 通路(probe: ramdisk)总开关
#MAMMOTH_RAMDISK_ENABLED=false
# alpine 载体:standard ISO(探针/agent 介质)+ netboot tarball(PXE 载体
# 必需——standard initramfs 缺机房网卡驱动)。无带外认领(enroll)也依赖
# netboot tarball,缺它探针树构建失败(启动即报错)。
#MAMMOTH_PROBE_ALPINE_ISO=/data/mammoth/work/alpine-standard-3.22.5-x86_64.iso
#MAMMOTH_PROBE_ALPINE_NETBOOT=/data/mammoth/work/alpine-netboot-3.22.5-x86_64.tar.gz
# 探针 tty2 调试 shell(busybox telnetd :2323;无串口无操作员机器的现场窗口)
#MAMMOTH_PROBE_DEBUG=false
# 无 ssh.address 机器的探针寻址回退:静态 CIDR/网关/前缀(跨段报告目标;
# 空 = 走 DHCP)
#MAMMOTH_PROBE_STATIC_CIDR=198.51.100.210/24
#MAMMOTH_PROBE_GATEWAY=198.51.100.1
#MAMMOTH_PROBE_PREFIX=24
# 探针报告等待预算
#MAMMOTH_PROBE_WAIT=10m
# 工控机 POC 过渡开关(fake 盘容量;正式部署勿用,空 = 关)
#MAMMOTH_FAKE_DISK_GBYTES=

# ═══ 7. 发行版介质与安装源 ═════════════════════════════════════════════

# Debian installer(d-i)netboot 资产(空 = debian PXE 通路未备)
#MAMMOTH_PXE_DI_NETBOOT=/data/mammoth/work/netboot-trixie.tar.gz
#MAMMOTH_PXE_DI_UDEBS_DIR=/data/mammoth/work/di-udebs
# ubuntu(autoinstall)apt 镜像(PXE 载体):subiquity 开局检查镜像,离线
# 装机段用默认 archive.ubuntu.com 会卡在交互对话框(2288H V5 实证)。
# 中国部署:MAMMOTH_UBUNTU_APT_MIRROR=http://mirrors.aliyun.com/ubuntu/
#MAMMOTH_UBUNTU_APT_MIRROR=
# Windows wimboot setup 通路的部署层 SMB 只读导出(空 = setup 通路不可用;
# agent/auto 安装器不走 SMB;UNC 反斜杠原样;USER/PASSWORD 空 = guest 导出)
#MAMMOTH_WINDOWS_INSTALL_SMB_UNC=\\198.51.100.248\mammoth-media
#MAMMOTH_WINDOWS_INSTALL_SMB_USER=mammoth-smb
#MAMMOTH_WINDOWS_INSTALL_SMB_PASSWORD=
# windows agent apply-image 通路免 SMB,改用 alpine extended ISO(空 = 未备)
#MAMMOTH_WINDOWS_APPLY_ALPINE_ISO=

# ═══ 8. 执行面(BMC/装机;形态 B 配在 runner,api 不发起 BMC 调用)════════

# 工厂 BMC 证书普遍无信任链(自签)
#MAMMOTH_BMC_TLS_INSECURE=false
# BMC 等待预算:华为 iBMC vMedia 挂载 12-15s + Connect 概率失败(≤3 重试),
# 默认 30s 偏紧,华为机器建议 90s
#MAMMOTH_BMC_TIMEOUT=30s
# 安装器控制台:serial=SOL 运维面(默认);vga=KVM 看画面
#MAMMOTH_INSTALL_CONSOLE=serial
# ipmitool 接口形态
#MAMMOTH_IPMI_INTERFACE=lanplus
# boot 后沉淀等待 / 带内操作预算 / 装后核验等待(默认已按真机校准)
#MAMMOTH_BOOT_SETTLE_DELAY=0s
#MAMMOTH_INBAND_TIMEOUT=20s
#MAMMOTH_VERIFY_READY_WAIT=10m
# 救援报告等待独立预算(空 = 运行时回退 25m;真机实证 10m 会杀死引导中的
# agent)
#MAMMOTH_RESCUE_WAIT=25m
# BIOS 档案/擦盘的提交期确认门(required|optional;关闭需显式承担风险)
#MAMMOTH_BIOS_CONFIRM=required
#MAMMOTH_ERASE_CONFIRM=required

# ═══ 9. 队列与可观测(默认值即生产形态;调优才动)════════════════════════

# runner 任务并发与任务级重试上限
#MAMMOTH_RUNNER_CONCURRENCY=10
#MAMMOTH_RUNNER_MAX_TASK_ATTEMPTS=5
# 队列:可见性超时 / reaper 轮询 / 收件轮询 / 重试退避 / 最大接收次数
#MAMMOTH_VISIBILITY_TIMEOUT=30s
#MAMMOTH_REAPER_INTERVAL=15s
#MAMMOTH_QUEUE_POLL_INTERVAL=250ms
#MAMMOTH_QUEUE_RETRY_BACKOFF=5s
#MAMMOTH_QUEUE_MAX_RECEIVE_COUNT=5
# 心跳 / 任务状态上报 / 任务日志保留 / layout 快照保留(份) / 幂等 TTL
#MAMMOTH_HEARTBEAT_INTERVAL=10s
#MAMMOTH_HEARTBEAT_TIMEOUT=60s
#MAMMOTH_TASK_STATUS_INTERVAL=2s
#MAMMOTH_TASK_LOGS_TTL=2160h
#MAMMOTH_LAYOUT_RETENTION=10
#MAMMOTH_IDEMPOTENCY_TTL=24h
# 介质中继(BMC 直挂不可达时的代理通路;ADDR 空 = 整组关闭)
#MAMMOTH_MEDIA_RELAY_ADDR=
#MAMMOTH_MEDIA_RELAY_DIR=
#MAMMOTH_MEDIA_RELAY_USER=
#MAMMOTH_MEDIA_RELAY_PASSWORD=
# fake BMC 动作延迟(POC;空 = 关)
#MAMMOTH_FAKE_BMC_DELAY=
# compat 目录覆盖(空 = 随仓库/安装前缀)
#MAMMOTH_COMPAT_DIR=
