# mammoth pxe-proxy — dotenv example (bare-binary deployment on the edge
# host of a provisioning VLAN). Copy to a stable path, edit the values, then:
#   MAMMOTH_ENV_FILE=/etc/mammoth-pxe-proxy.env mammoth pxe-proxy
# (or point the systemd unit's EnvironmentFile at it — see
#  docs/operations.md §pxe-proxy for the full unit example.)

# The engine's machine-face base URL: where the kit is synced from and
# where PXE sightings are reported.
MAMMOTH_PXEPROXY_BASE_URL=http://198.51.100.248:8080

# This host's IP on the provisioning segment (offered as siaddr/TFTP-server
# to PXE clients). Optional — when unset, the address is learned from the
# interface the first PXE request arrives on. Set it explicitly on
# multi-homed hosts or when running in a container.
#MAMMOTH_PXEPROXY_NEXT_SERVER=198.51.100.10

# Bearer token for the engine kit endpoint (empty = anonymous; the /netboot
# routes are public by default).
#MAMMOTH_PXEPROXY_KIT_TOKEN=

# Informational segment label reported with sightings.
#MAMMOTH_PXEPROXY_SEGMENT=vlan-100

# TFTP root for the synced kit. Auto-synced from the engine: download to a
# temp directory, two-step rename swap (the TFTP root never disappears).
#MAMMOTH_PXEPROXY_TFTP_ROOT=/var/lib/mammoth/tftp

# Kit re-sync period; 0 = sync once at startup.
#MAMMOTH_PXEPROXY_SYNC_INTERVAL=5m
