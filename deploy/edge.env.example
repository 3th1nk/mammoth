# mammoth edge — 边缘代理环境变量模板(每装机 VLAN 一个实例)
#
# edge = 装机网段的 Go 原生第一跳:proxyDHCP
# (:67/:4011)应答引导信息 + TFTP(:69)服务引擎导出的 external kit(自动
# 同步)+ PXE sightings 回传 + 安装器日志 sink(:514)+ 可选 WoL 中继。
# 本服务永不分配地址——地址归该网段的站点 DHCP;安装决策归中心引擎
# (kit 的 boot.ipxe 蹦床 chain 回引擎 per-MAC 脚本)。
#
# 用法(裸二进制):
#   MAMMOTH_ENV_FILE=/etc/mammoth-edge.env mammoth edge
#   (或 systemd unit 的 EnvironmentFile 指向它——完整 unit 见
#    docs/operations.md §4.5.1 edge 节)
# compose 部署:deploy/compose.edge.yml(host 网络;tftp-root 卷挂载)。
# 每个变量都有 MAMMOTH_EDGE_* env 覆盖,compose 直接传环境变量即可。
# 注释行展示的 = 默认值;逐变量完整释义:docs/env-vars.md §10。
#
# ── 部署前提(违反即引导断粮)──────────────────────────────────────────
# · 必须在机器 L2 内(DHCP 广播不跨段);多装机 VLAN = 每段一个 edge;
# · 不能与站点 DHCP 同机(UDP 67 冲突);
# · 引擎机器面(BASE_URL 指向的地址)必须从本机与被装机器可路由;
# · 防火墙:67/69/4011(UDP)入站(装机段);出站到引擎 8080(TCP);
#   9100(TCP,仅引擎来源)开了 WoL 中继才放行。
# 落点原则/共存边界/排障第一检查点(sighting):docs/operations.md §edge 节。

# ── 必改项 ──────────────────────────────────────────────────────────────
# 中心引擎机器面基地址:kit 从这里同步,sightings 回传到这里;被装机器拉
# 脚本/介质、完成回调同走此地址(与引擎侧 MAMMOTH_EXTERNAL_URL 同值)。
MAMMOTH_EDGE_BASE_URL=http://198.51.100.248:8080

# 本机在装机网段的地址(发给 PXE 客户端的 siaddr/TFTP-server)——
# 填 edge 自己,不是引擎(客户端按它拉 TFTP,填错 = PXE-E32)。
# 装机窗口内地址不能变:手动配置或 DHCP 保留。单网卡主机可留空(从首个
# PXE 请求的到达接口自动学习,IP_PKTINFO);多网卡/容器建议显式指定。
#MAMMOTH_EDGE_NEXT_SERVER=198.51.100.10

# ── UEFI NBP 链(装机网段 UEFI 机型的关键开关,部署级决策)─────────────
#   shim = 签名链(shim→grubnet),Secure Boot 有效——但 grub2 不消费
#          UEFI Proxy DHCP 消息(RackN KB-00043 / RH #1809246),**站点
#          DHCP 不可控的 proxy 拓扑下 UEFI 机型引导失败**(签名:TFTP
#          全通 → 静默落 GRUB 提示符);
#   ipxe = 未签名裸 iPXE,绕开上述缺陷(iPXE 自己重新 DHCP,proxyDHCP
#          的参考客户端),要求机型关闭 Secure Boot——站点 DHCP 不可控
#          拓扑的 UEFI 机型开关;BIOS 机型不受影响(恒走 undionly→iPXE)。
# 按机型分型的完整判据矩阵:docs/operations.md §共存节。
#MAMMOTH_EDGE_UEFI_NBP=shim

# ── 可选项 ──────────────────────────────────────────────────────────────
# 引擎 kit 端点的 Bearer token(引擎 /netboot 路由默认公开时留空)
#MAMMOTH_EDGE_KIT_TOKEN=
# 装机网段标签(sightings 回传携带,信息性;命名可读即可)
#MAMMOTH_EDGE_SEGMENT=vlan-100
# TFTP root(kit 自动落位:启动 + 周期同步,ETag 协商内容未变零下载,
# 原子换根失败保留旧 root)。建议独立目录便于备份。
#MAMMOTH_EDGE_TFTP_ROOT=/var/lib/mammoth/tftp
# kit 重同步周期;0 = 仅启动时同步一次。两个易误判语义:
# · 0 只禁周期,启动初始同步仍执行——联调期手工改过 TFTP root 的文件,
#   一次 restart 就被引擎 kit 覆盖回去(先 restart 再改,且预期被覆盖);
# · ETag 未变时本地文件不会被覆盖(304 零下载)。
#MAMMOTH_EDGE_SYNC_INTERVAL=5m
# 安装器日志 sink 端口(绑定失败仅降级警告,不拦启动)
#MAMMOTH_EDGE_SYSLOG_PORT=514
# 端口覆盖(默认 67/4011/69;宿主已占用或非特权环境时改)
#MAMMOTH_EDGE_DHCP_PORT=67
#MAMMOTH_EDGE_PROXY_PORT=4011
#MAMMOTH_EDGE_TFTP_PORT=69

# ── edge-pool:本段无站点 DHCP 时的地址服务(默认关)────────────────────
# 语法与引擎 MAMMOTH_PXE_DHCP_POOL 同型:区间(末八位缩写可)或逗号列表。
# 只在"本段确实没有站点 DHCP"时启用——开了它,edge 就是本段唯一的地址
# 服务,与段内站点 DHCP 并存 = 双地址服务竞争(启动探测会告警)。
# 门控语义:租约只发给引擎清单上的 MAC(armed 装机条目 + enroll 台账里的
# 未注册 sighting)——清单从引擎 /netboot/pool-manifest.json 周期同步
# (与 kit 同一 ticker、同 ETag 形态;初始同步失败拒绝启动,死池必须大声)。
# 陌生 MAC(办公网的打印机/笔记本)永远拿不到地址。新分配的地址先做
# 存活探测(ping + ARP 表):池范围撞上段内静态设备时自动跳过。
# 与引擎池的差异:静态 ip= 预留只在引擎侧做(预留与 DHCP 应答同池同源),
# edge 场景 ubuntu 装机期走 boot-time DHCP 或 spec 声明静态网
# (docs/operations.md §edge)。
#MAMMOTH_EDGE_DHCP_POOL=198.51.100.150-198.51.100.179

# ── Wake-on-LAN 中继(可选,默认关)────────────────────────────────────
# 引擎不在机器段时的无带外唤醒:引擎 boot 阶段 POST /wol {"mac":...} 到
# LISTEN 地址,本服务在装机段发 magic packet(WoL 是 L2 广播,引擎够不着
# 睡眠机,代理本就在段内)。与引擎侧 MAMMOTH_PXE_WOL_PROXY_URL /
# MAMMOTH_PXE_WOL_PROXY_TOKEN 配对(TOKEN 两边同值)。不开则装机时人工
# 上电——boot 证据窗口等待,人工上电即自愈。依赖目标机网卡支持 + ErP/S5
# 深睡同核(S5 断网卡电,包没人收)。
#MAMMOTH_EDGE_WOL_LISTEN=:9100
#MAMMOTH_EDGE_WOL_TOKEN=change-me-same-as-engine-wol-proxy-token
# 装机段定向广播是最精确形态;255.255.255.255 为兜底
#MAMMOTH_EDGE_WOL_BROADCAST=198.51.100.255
